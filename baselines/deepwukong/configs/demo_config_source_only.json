{
  "baseline_name": "deepwukong_xfg_baseline",
  "baseline_status": "Same as demo_config.json; retained for Demo A CLI compatibility",
  "selection": {
    "model": "DeepWuKong GCN CWE119",
    "checkpoint": "models/deepwukong/deepwukong_cwe119_best.ckpt",
    "threshold": 0.5,
